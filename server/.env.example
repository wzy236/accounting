# Supabase 项目 URL，跟 web/src/lib/config.js 里默认用的应该是同一个项目
SUPABASE_URL=https://xxxx.supabase.co

# service_role key —— 在 Supabase 后台 Project Settings -> API 里找，权限极高，
# 能绕过 RLS 直接读写所有用户的数据，只能放在这个后端的环境变量里，绝对不能给前端、不能提交进仓库。
SUPABASE_SERVICE_ROLE_KEY=xxxx

# 触发 /api/recurring-bills/run 需要带的密钥（自己随便生成一个足够长的随机字符串），
# 防止别人随便打这个接口。GitHub Actions 里对应配成 secrets.CRON_SECRET。
CRON_SECRET=change-me-to-a-random-string

PORT=3000
