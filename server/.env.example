# Supabase 项目 URL，跟 web/src/lib/config.js 里默认用的应该是同一个项目
SUPABASE_URL=https://xxxx.supabase.co

# service_role key —— 在 Supabase 后台 Project Settings -> API 里找，权限极高，
# 能绕过 RLS 直接读写所有用户的数据，只能放在这里本地调试用，绝对不能给前端、不能提交进仓库。
# 部署到 GitHub Actions 时对应配成仓库的 secrets.SUPABASE_SERVICE_ROLE_KEY。
SUPABASE_SERVICE_ROLE_KEY=xxxx
