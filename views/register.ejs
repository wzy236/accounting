<%- include('partials/head', { title: '注册', active: null }) %>

<div class="auth-card">
  <h1>注册</h1>
  <% if (error) { %>
    <p class="error"><%= error %></p>
  <% } %>
  <form method="post" action="/register">
    <label>用户名
      <input type="text" name="username" minlength="3" required autofocus />
    </label>
    <label>密码
      <input type="password" name="password" minlength="6" required />
    </label>
    <label>确认密码
      <input type="password" name="confirm" minlength="6" required />
    </label>
    <button type="submit" class="btn primary">注册</button>
  </form>
  <p class="auth-switch">已有账号？<a href="/login">直接登录</a></p>
</div>

<%- include('partials/foot') %>
