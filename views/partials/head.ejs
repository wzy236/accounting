<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= typeof title !== 'undefined' ? title + ' · 记账本' : '记账本' %></title>
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body>
<% if (currentUser) { %>
<header class="topbar">
  <div class="topbar-inner">
    <a class="brand" href="/transactions">📒 记账本</a>
    <nav class="nav">
      <a href="/transactions" class="<%= active === 'transactions' ? 'active' : '' %>">记账</a>
      <a href="/charts" class="<%= active === 'charts' ? 'active' : '' %>">统计图表</a>
      <a href="/categories" class="<%= active === 'categories' ? 'active' : '' %>">分类管理</a>
      <a href="/import" class="<%= active === 'import' ? 'active' : '' %>">导入对账单</a>
    </nav>
    <div class="user-area">
      <span class="username"><%= currentUser.username %></span>
      <form action="/logout" method="post" class="inline-form">
        <button type="submit" class="link-btn">退出</button>
      </form>
    </div>
  </div>
</header>
<% } %>
<main class="container">
