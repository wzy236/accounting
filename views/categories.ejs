<%- include('partials/head', { title: '分类管理', active: 'categories' }) %>

<h1>分类管理</h1>

<section class="add-form-section">
  <h2>新增分类</h2>
  <form method="post" action="/categories" class="tx-form">
    <div class="tx-form-row">
      <label>名称
        <input type="text" name="name" placeholder="例如：宠物" required />
      </label>
      <label>类型
        <select name="type">
          <option value="expense">支出</option>
          <option value="income">收入</option>
        </select>
      </label>
      <label>颜色
        <input type="color" name="color" value="#5c9ead" />
      </label>
      <button type="submit" class="btn primary">添加分类</button>
    </div>
  </form>
</section>

<div class="category-columns">
  <section>
    <h2>支出分类</h2>
    <ul class="category-list">
      <% expense.forEach(function(c) { %>
        <li>
          <span class="swatch" style="background: <%= c.color %>"></span>
          <span class="cat-name"><%= c.name %></span>
          <form method="post" action="/categories/<%= c.id %>/delete" class="inline-form"
            onsubmit="return confirm('删除后该分类下的记录会变为未分类，确认删除？')">
            <button type="submit" class="link-btn danger">删除</button>
          </form>
        </li>
      <% }); %>
      <% if (expense.length === 0) { %><li class="empty">暂无支出分类</li><% } %>
    </ul>
  </section>

  <section>
    <h2>收入分类</h2>
    <ul class="category-list">
      <% income.forEach(function(c) { %>
        <li>
          <span class="swatch" style="background: <%= c.color %>"></span>
          <span class="cat-name"><%= c.name %></span>
          <form method="post" action="/categories/<%= c.id %>/delete" class="inline-form"
            onsubmit="return confirm('删除后该分类下的记录会变为未分类，确认删除？')">
            <button type="submit" class="link-btn danger">删除</button>
          </form>
        </li>
      <% }); %>
      <% if (income.length === 0) { %><li class="empty">暂无收入分类</li><% } %>
    </ul>
  </section>
</div>

<%- include('partials/foot') %>
