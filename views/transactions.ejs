<%- include('partials/head', { title: '记账', active: 'transactions' }) %>

<% if (imported > 0) { %>
  <p class="success">成功从 PDF 导入 <%= imported %> 条记录。</p>
<% } %>

<div class="page-header">
  <h1>记账</h1>
  <form method="get" action="/transactions" class="month-picker">
    <input type="month" name="month" value="<%= month %>" onchange="this.form.submit()" />
  </form>
</div>

<div class="summary-cards">
  <div class="card income">
    <span class="label">本月收入</span>
    <span class="value">¥<%= income.toFixed(2) %></span>
  </div>
  <div class="card expense">
    <span class="label">本月支出</span>
    <span class="value">¥<%= expense.toFixed(2) %></span>
  </div>
  <div class="card balance">
    <span class="label">本月结余</span>
    <span class="value">¥<%= balance.toFixed(2) %></span>
  </div>
</div>

<section class="add-form-section">
  <h2>新增一笔</h2>
  <form method="post" action="/transactions" class="tx-form" id="add-form">
    <input type="hidden" name="month" value="<%= month %>" />
    <div class="tx-form-row">
      <label>日期
        <input type="date" name="date" value="<%= month %>-<%= new Date().getDate().toString().padStart(2,'0') %>" required />
      </label>
      <label>类型
        <select name="type" class="type-select">
          <option value="expense">支出</option>
          <option value="income">收入</option>
        </select>
      </label>
      <label>分类
        <select name="category_id" class="category-select"></select>
      </label>
      <label>金额
        <input type="number" name="amount" step="0.01" min="0.01" placeholder="0.00" required />
      </label>
      <label class="grow">备注
        <input type="text" name="description" placeholder="选填" />
      </label>
      <button type="submit" class="btn primary">添加</button>
    </div>
  </form>
</section>

<section>
  <h2>本月明细</h2>
  <table class="tx-table">
    <thead>
      <tr>
        <th>日期</th><th>类型</th><th>分类</th><th>金额</th><th>备注</th><th>来源</th><th></th>
      </tr>
    </thead>
    <tbody>
      <% transactions.forEach(function(t) { %>
        <tr>
          <td><input type="date" name="date" form="edit-form-<%= t.id %>" value="<%= t.date %>" required /></td>
          <td>
            <select name="type" form="edit-form-<%= t.id %>" class="type-select">
              <option value="expense" <%= t.type === 'expense' ? 'selected' : '' %>>支出</option>
              <option value="income" <%= t.type === 'income' ? 'selected' : '' %>>收入</option>
            </select>
          </td>
          <td>
            <select name="category_id" form="edit-form-<%= t.id %>" class="category-select" data-current="<%= t.category_id || '' %>"></select>
          </td>
          <td><input type="number" name="amount" form="edit-form-<%= t.id %>" step="0.01" min="0.01" value="<%= t.amount %>" required /></td>
          <td><input type="text" name="description" form="edit-form-<%= t.id %>" value="<%= t.description %>" /></td>
          <td><span class="tag source-<%= t.source %>"><%= t.source === 'pdf_import' ? 'PDF导入' : '手动' %></span></td>
          <td class="row-actions">
            <button type="submit" form="edit-form-<%= t.id %>" class="link-btn">保存</button>
          </td>
          <td class="delete-cell">
            <button type="submit" form="delete-form-<%= t.id %>" class="link-btn danger"
              onclick="return confirm('确认删除这条记录？')">删除</button>
          </td>
        </tr>
      <% }); %>
      <% if (transactions.length === 0) { %>
        <tr><td colspan="8" class="empty">本月还没有记录</td></tr>
      <% } %>
    </tbody>
  </table>
  <% transactions.forEach(function(t) { %>
    <form id="edit-form-<%= t.id %>" method="post" action="/transactions/<%= t.id %>"></form>
    <form id="delete-form-<%= t.id %>" method="post" action="/transactions/<%= t.id %>/delete"></form>
  <% }); %>
</section>

<script>
  window.__CATEGORIES__ = <%- JSON.stringify(categories) %>;
</script>
<script src="/js/app.js"></script>

<%- include('partials/foot') %>
