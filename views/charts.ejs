<%- include('partials/head', { title: '统计图表', active: 'charts' }) %>

<div class="page-header">
  <h1>统计图表</h1>
  <form method="get" action="/charts" class="month-picker">
    <input type="month" name="month" value="<%= month %>" onchange="this.form.submit()" />
  </form>
</div>

<div class="chart-columns">
  <section class="chart-card">
    <h2>支出分布 <span class="muted">（合计 ¥<%= expenseTotal.toFixed(2) %>）</span></h2>
    <% if (expenseData.length === 0) { %>
      <p class="empty">本月暂无支出记录</p>
    <% } else { %>
      <canvas id="expense-pie" width="360" height="360"></canvas>
    <% } %>
  </section>

  <section class="chart-card">
    <h2>收入分布 <span class="muted">（合计 ¥<%= incomeTotal.toFixed(2) %>）</span></h2>
    <% if (incomeData.length === 0) { %>
      <p class="empty">本月暂无收入记录</p>
    <% } else { %>
      <canvas id="income-pie" width="360" height="360"></canvas>
    <% } %>
  </section>
</div>

<script src="/js/chart.umd.min.js"></script>
<script>
  var expenseData = <%- JSON.stringify(expenseData) %>;
  var incomeData = <%- JSON.stringify(incomeData) %>;

  function drawPie(canvasId, data) {
    var el = document.getElementById(canvasId);
    if (!el || data.length === 0) return;
    new Chart(el.getContext('2d'), {
      type: 'pie',
      data: {
        labels: data.map(function (d) { return d.name; }),
        datasets: [{
          data: data.map(function (d) { return d.total; }),
          backgroundColor: data.map(function (d) { return d.color; }),
        }],
      },
      options: {
        plugins: {
          legend: { position: 'bottom' },
          tooltip: {
            callbacks: {
              label: function (ctx) {
                var total = ctx.dataset.data.reduce(function (a, b) { return a + b; }, 0);
                var pct = total ? ((ctx.parsed / total) * 100).toFixed(1) : '0.0';
                return ctx.label + ': ¥' + ctx.parsed.toFixed(2) + ' (' + pct + '%)';
              },
            },
          },
        },
      },
    });
  }

  drawPie('expense-pie', expenseData);
  drawPie('income-pie', incomeData);
</script>

<%- include('partials/foot') %>
